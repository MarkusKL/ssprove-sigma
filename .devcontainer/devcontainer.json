{
  "name": "ssprove-devcontainer",
  "image": "ghcr.io/xtruder/nix-devcontainer:v1",
  "onCreateCommand": "cp -r .config ~/ && nix-shell codespace.nix --run 'make'",

  "customizations": {
    "vscode": {
      "settings": {
        "nixEnvSelector.nixFile": "${workspaceFolder}/codespace.nix"
      },
      "extensions": [
        "arrterian.nix-env-selector",
        "ejgallego.coq-lsp"
      ]
    }
  }
}
